{
  "name": "Costura",
  "build": { "dockerfile": "Dockerfile" },
  "features": {
    // docker-in-docker 2.17.0
    "ghcr.io/devcontainers/features/docker-in-docker@sha256:25b9f05705ffba7dbe503230ac76081419306f8c8bc88e0ce78c4ecd99a0c78c": {}
  },
  "remoteUser": "vscode",
  "containerEnv": { "MISE_YES": "1" },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "forwardPorts": [3000, 8000],
  "portsAttributes": {
    "3000": { "label": "web" },
    "8000": { "label": "api" }
  }
}
