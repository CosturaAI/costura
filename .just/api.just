_root := justfile_directory()
_api := _root / "apps" / "api"

# Install API dependencies into apps/api/.venv (uv sync, locked).
setup:
    cd "{{_api}}" && uv sync --frozen

# Build a wheel and import it from a clean environment (not the source tree).
package-check:
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{_api}}"
    work=$(mktemp -d)
    trap 'rm -rf "$work"' EXIT
    uv build --out-dir "$work/dist"
    uv venv "$work/venv" --python 3.14
    shopt -s nullglob
    wheels=("$work"/dist/costura_api-*.whl)
    [[ ${#wheels[@]} -eq 1 ]] || { echo "error: expected one wheel, found ${#wheels[@]}" >&2; exit 1; }
    uv pip install --python "$work/venv/bin/python" "${wheels[0]}"
    cd "$work"
    "$work/venv/bin/python" "{{_root}}/scripts/check-api-package.py"

# Run the API with reload on http://127.0.0.1:8000.
dev:
    cd "{{_api}}" && uv run uvicorn costura.main:app --reload --host 127.0.0.1 --port 8000

# Run pytest (requires PostgreSQL: just db::up).
test *args:
    cd "{{_api}}" && uv run pytest {{args}}

# Tests that need no PostgreSQL; any test using the database is marked integration.
test-unit *args:
    cd "{{_api}}" && uv run pytest -m unit {{args}}

# Tests that exercise PostgreSQL, provider sync, or multiple components.
test-integration *args:
    cd "{{_api}}" && uv run pytest -m integration {{args}}

# Rewrite tests/snapshots/openapi.json from the running FastAPI app. Review the diff.
openapi:
    cd "{{_api}}" && UPDATE_OPENAPI_SNAPSHOT=1 uv run pytest tests/test_openapi_contract.py

# Run pytest with line and branch coverage; fails under fail_under in pyproject.toml.
coverage *args:
    cd "{{_api}}" && uv run pytest --cov --cov-report=term --cov-report=xml --cov-report=json {{args}}

# Fail when lines changed since `base` are under 90% covered; run `just api::coverage` first.
diff-coverage base="origin/main":
    cd "{{_api}}" && uv run diff-cover coverage.xml --compare-branch={{base}} --fail-under=90

# Lint with Ruff.
lint:
    cd "{{_api}}" && uv run ruff check .

# Type check with ty.
typecheck:
    cd "{{_api}}" && uv run ty check costura

# Check formatting with Ruff.
format-check:
    cd "{{_api}}" && uv run ruff format --check .

# Fix lint and formatting.
fix:
    cd "{{_api}}" && uv run ruff check --fix . && uv run ruff format .

# Apply Alembic migrations up to head.
migrate:
    cd "{{_api}}" && uv run alembic upgrade head

# Needs PostgreSQL up and migrated (just db::up, just api::migrate); rewrites the README inventory.
# Create an autogenerated Alembic revision: just api::revision "add spend table"
revision message:
    cd "{{_api}}" && uv run alembic revision --autogenerate -m "{{message}}"
    cd "{{justfile_directory()}}" && just api::migration-inventory

# Rewrite the migration inventory in apps/api/README.md from the Alembic chain.
migration-inventory:
    cd "{{_api}}" && uv run python "{{justfile_directory()}}/scripts/update-migration-inventory.py"

# Show current Alembic revision.
db-current:
    cd "{{_api}}" && uv run alembic current

# Validate the complete migration chain against a disposable PostgreSQL database.
migration-check:
    cd "{{justfile_directory()}}" && just db::up
    cd "{{_api}}" && uv run python tests/migration_check.py

# Publish the read-only sample organization `demo` when missing or outdated (needs no COSTURA_SECRET_KEY).
demo-seed:
    cd "{{_api}}" && uv run python -m costura.ops.demo_seed seed

# Rebuild the sample organization through today and swap it in (the old one stays on failure).
demo-refresh:
    cd "{{_api}}" && uv run python -m costura.ops.demo_seed refresh

# Print the published sample's dataset version and freshness; exits 1 when stale. `--json` prints one JSON object.
demo-status *args:
    cd "{{_api}}" && uv run python -m costura.ops.demo_seed status {{args}}

# --once also drains the queue. The long-running form only enqueues.
# Enqueue the daily sync: just api::scheduler [--at HH:MM] [--once]
scheduler *args:
    cd "{{_api}}" && uv run python -m costura.ops.scheduler {{args}}

# Claim and run queued syncs: just api::worker [--once]
worker *args:
    cd "{{_api}}" && uv run python -m costura.ops.worker {{args}}

# Print pass/fail and percent deltas per provider and month, no amounts: just api::tieout-report --org default --months 3 [--json]
tieout-report *args:
    cd "{{_api}}" && uv run python -m costura.ops.tieout {{args}}

# Write stored provider pages as redacted fixtures, no provider call: just api::capture-fixtures anthropic ./captured [--org default] [--pages 3]
capture-fixtures provider out_dir *args:
    #!/usr/bin/env bash
    set -euo pipefail
    out="{{out_dir}}"
    [[ "$out" = /* ]] || out="{{invocation_directory()}}/$out"
    cd "{{_api}}"
    uv run python -m costura.ops.capture_fixtures "{{provider}}" "$out" {{args}}

# Delete raw provider pages and terminal runs past retention.
purge:
    cd "{{_api}}" && uv run python -m costura.ops.purge

# Print a new COSTURA_OPERATOR_SECRET (24+ urlsafe characters) for .env.
operator-secret:
    python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# Print a new COSTURA_SECRET_KEY for .env.
secret-generate:
    cd "{{_api}}" && uv run python -m costura.ops.secret generate

# Re-encrypt stored secrets with the current key; old key from COSTURA_SECRET_KEY_PREVIOUS or stdin.
secret-rotate:
    cd "{{_api}}" && uv run python -m costura.ops.secret rotate

# First owner of an organization with no members; `--create` creates it first: just api::claim-owner default me@example.com
claim-owner slug email *args:
    cd "{{_api}}" && uv run python -m costura.ops.claim_owner {{slug}} {{email}} {{args}}
