# Copy to .env (gitignored). COSTURA_ENV is required; never commit real credentials.
COSTURA_ENV=development

# Release that docker-compose.prod.yml runs (ghcr.io/costuraai/costura-*:<version>). Required
# there; `latest` is not a supported install. Development does not read it.
# x-release-please-start-version
COSTURA_VERSION=0.1.0
# x-release-please-end

# PostgreSQL container (docker-compose.yml). In production POSTGRES_USER owns the schema and
# only the migration job uses it; POSTGRES_PASSWORD must not stay `costura` there.
POSTGRES_DB=costura
POSTGRES_USER=costura
POSTGRES_PASSWORD=costura
# docker-compose.prod.yml only: the role the API, worker and scheduler connect as. It reads
# and writes rows and cannot change the schema. The migration creates it and sets this
# password. At least 12 characters of letters, digits and _-.; not the owner's password.
POSTGRES_APP_USER=costura_app
POSTGRES_APP_PASSWORD=

# Connection strings used by the API (native process) and Alembic
DATABASE_URL=postgresql+psycopg://costura:costura@localhost:5432/costura
TEST_DATABASE_URL=postgresql+psycopg://costura:costura@localhost:5432/costura_test

# Provider keys used as a fallback for the `COSTURA_ORG` organization when it has no stored
# credential; create that organization with `just api::claim-owner default you@example.com --create`. Per-organization keys are stored encrypted from the web settings page. Every client is read-only. Leave empty here; never committed.
# Anthropic Admin API key (sk-ant-admin01-...).
ANTHROPIC_ADMIN_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# Claude.ai Enterprise Analytics key with read:analytics.
CLAUDE_AI_API_KEY=
# CLAUDE_AI_BASE_URL=https://api.anthropic.com
# OpenRouter management key (sk-or-v1-...), created under Settings, Management keys.
OPENROUTER_ADMIN_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OpenAI admin key (sk-admin-...), created under Organization settings, Admin keys, with
# read permission on usage and on the organization (projects, users, API keys).
OPENAI_ADMIN_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# Codex Admin API key (sk-admin-...) with codex.enterprise.analytics.read, and the ChatGPT
# workspace UUID it reads. Both are required for the environment fallback.
CODEX_ADMIN_KEY=
CODEX_WORKSPACE_ID=
# CODEX_BASE_URL=https://api.chatgpt.com/v1/analytics/codex
# Cursor team API key (key_...), created under Dashboard, Settings, Integrations.
CURSOR_API_KEY=
# CURSOR_BASE_URL=https://api.cursor.com
# GitHub Copilot (experimental): a classic token of an organization owner or billing manager
# and the organization login.
COPILOT_GITHUB_TOKEN=
COPILOT_ORG=
# COPILOT_BASE_URL=https://api.github.com

# Fernet key that encrypts stored provider credentials: `just api::secret-generate`.
# Required by the scheduler and the connection write routes. Never committed.
COSTURA_SECRET_KEY=
# Only during a key rotation: the key being replaced. Reads accept it until
# `just prod::secret-rotate` has rewritten every row; then remove it (SECURITY.md).
# COSTURA_SECRET_KEY_PREVIOUS=

# Daily time (UTC, HH:MM) at which `just api::scheduler` syncs every organization.
COSTURA_SCHEDULE_AT=06:00
# DEBUG, INFO, WARNING or ERROR for the costura loggers.
# COSTURA_LOG_LEVEL=INFO

# Organization that may use the fallback provider keys above. The web app refuses to create
# this slug; create it with `just prod::claim-owner <slug> <email> --create` (or api::).
# The web root does not read it: the signed-in user's organizations decide where `/` lands.
COSTURA_ORG=default

# Web -> API base URL (server-side fetch in Next.js) and the browser origin the API allows (CORS).
# Open the app at http://127.0.0.1:3000 so this origin matches. `localhost` can resolve to ::1.
COSTURA_API_URL=http://127.0.0.1:8000
COSTURA_WEB_ORIGIN=http://127.0.0.1:3000

# Google OAuth web application credentials. Google redirects to
# {COSTURA_WEB_PUBLIC_URL}/api/auth/google/callback. Leave either credential empty to keep
# Google sign-in disabled; development/test loopback sign-in remains available locally.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Self-hosted production sign-in without Google. Both are required, and the secret is at
# least 24 characters (`just api::operator-secret` prints one). This is the simple first
# login: sign in as this address, create the organization, then connect a provider.
# A Google-only install stays invitation-only, so also set one of these before the first
# person can create an account: this operator pair, COSTURA_SIGN_UP=open, or
# COSTURA_ALLOWED_EMAIL_DOMAINS. Never commit the secret.
COSTURA_OPERATOR_EMAIL=
COSTURA_OPERATOR_SECRET=
# COSTURA_SIGN_UP=invite_only
# COSTURA_ALLOWED_EMAIL_DOMAINS=example.com

# Public origin for the Google callback ({COSTURA_WEB_PUBLIC_URL}/api/auth/google/callback).
# Use HTTPS outside localhost. Leave empty to keep Google disabled.
COSTURA_WEB_PUBLIC_URL=

# Theme file stem in apps/web/src/themes (default costura) and light, dark, or system.
# COSTURA_THEME=costura
# COSTURA_COLOR_SCHEME=light
# Display name in the sidebar and the document title. The mark is public/brand/logo.svg.
# COSTURA_BRAND_NAME=Costura

# Rebuild the public sample on each daily scheduler pass when it is not current.
# The sample is synthetic and stores no provider key. Off by default.
# COSTURA_DEMO_REFRESH=false

# Months a new connection imports, the current one included (2 to 13). The daily run reads
# the current and the previous month. A month before the provider's history is skipped.
# COSTURA_BACKFILL_MONTHS=3

# A managed PostgreSQL instead of the bundled service (docs/operations/install.md).
# COSTURA_DATABASE_HOST=db.example.internal
# COSTURA_DATABASE_PORT=5432
# COSTURA_DATABASE_OPTIONS=sslmode=verify-full&sslrootcert=/run/costura/db-ca.crt

# Hosts an organization's signal webhook may post to, comma-separated. Empty (the default)
# keeps every signal inside the stack: no webhook can be saved and the worker posts nothing.
# For Slack incoming webhooks: hooks.slack.com
# COSTURA_WEBHOOK_HOSTS=

# age public key (age1...): `just prod::backup x.dump.age` encrypts the dump on the way out.
# Restoring such a dump needs the private key file in COSTURA_BACKUP_AGE_IDENTITY; keep that
# file off this host.
# COSTURA_BACKUP_AGE_RECIPIENT=
# COSTURA_BACKUP_AGE_IDENTITY=

# Requests per minute per client address: sign-in routes, writes, public sample reads.
# 0 turns a bucket off. The Next.js server is one address for every browser behind it.
# COSTURA_RATE_LIMIT_AUTH=20
# COSTURA_RATE_LIMIT_WRITE=120
# COSTURA_RATE_LIMIT_DEMO=3000
# Member reads per minute per session, and provider key stores (connect, add an account,
# replace a key; each calls the provider) per minute per organization.
# COSTURA_RATE_LIMIT_READ=1200
# COSTURA_RATE_LIMIT_CONNECT=10

# Days to keep raw provider response pages (`provider_report_pages`). 0 keeps them forever.
# COSTURA_RAW_PAGE_RETENTION_DAYS=90
# Days to keep terminal scheduler runs and completed sync runs that spend, inventory and
# allocation no longer reference. 0 keeps them forever. Referenced sync runs stay so those
# foreign keys remain valid; their raw pages still follow the page retention above.
# The worker runs this about once an hour. `just api::purge` runs one pass.
# COSTURA_RUN_RETENTION_DAYS=90

# Reverse proxies allowed to set X-Forwarded-For: comma-separated IPs or CIDRs, or *.
# Empty ignores the header and uses the TCP peer. A trusted peer's client is the rightmost
# forwarded hop that is not itself trusted (* takes the rightmost hop). Development writes
# still require that client to be loopback; an untrusted X-Forwarded-For keeps them refused.
# docker-compose.prod.yml does not publish the API port and defaults this to the Compose
# subnet, COSTURA_SUBNET (172.28.0.0/24). Do not publish port 8000.
# COSTURA_TRUSTED_PROXIES=
# Pick a free range when Docker reports "Pool overlaps with other one on this address space".
# COSTURA_SUBNET=172.28.0.0/24

# Public listener for docker-compose.prod.yml (deploy/Caddyfile).
# http://localhost is plain HTTP for a local trial. A bare hostname
# (costura.example.com) turns on Caddy's automatic HTTPS. No extra mailbox setting is required.
# COSTURA_SITE_ADDRESS=http://localhost
# Host ports published for that proxy.
# COSTURA_HTTP_PORT=80
# COSTURA_HTTPS_PORT=443
